    </item>
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#EBECF0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
